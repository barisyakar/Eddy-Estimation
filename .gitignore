.DS_Store
*.asv
*.m~
*.log
*.aux
*.out
/tmp/
/output/

# Source observations and manuscript material are not part of the public release.
/data/
/Mathematica/
/paper/
/overleaf*/

# Internal validation runs contain intermediate results and local provenance.
/reruns/
/run_paper_validation.m

# Keep only the two explicitly released constant-background simulations.
/exp_kernel/results/**
!/exp_kernel/results/Lifetime-first14days/
!/exp_kernel/results/Lifetime-first14days/validation/
!/exp_kernel/results/Lifetime-first14days/validation/sim_catalog.mat
!/exp_kernel/results/Lifetime-last14days/
!/exp_kernel/results/Lifetime-last14days/validation/
!/exp_kernel/results/Lifetime-last14days/validation/sim_catalog.mat

# Fitted workspaces are omitted; numerical summaries and final figures are kept.
/time_varying_intensity/results*/

# Keep exactly the figure PDFs referenced by the current Overleaf manuscript.
/figures/*
!/figures/acf15min-Lifetime-first14days.pdf
!/figures/acf15min-Lifetime-last14days.pdf
